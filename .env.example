# Required in production: signs sessions and encrypts stored Nuvion keys.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Postgres (hosted). Leave unset to use a local SQLite file (dev.db).
# DATABASE_URL=postgres://...
# Origins allowed to call the app, comma-separated (default: the live demo's addresses). Set your own.
# TRUSTED_ORIGINS=https://your-app.example.com
NUVION_BASE_URL=https://api.nuvion.dev
# Operator mode: local dev / scripts only. Leave unset on a public deployment (visitors bring their own key).
# NUVION_API_KEY=
# NUVION_WEBHOOK_SECRET=
# Local only: adds a "Simulate inflow" button. Never set on a public deployment.
# DEMO_SIMULATE=1
