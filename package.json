{
  "name": "better-auth-nuvion-example",
  "version": "0.1.0",
  "private": true,
  "description": "A Next.js app that uses @umohpyro/better-auth-nuvion: one payment split across a platform, reseller and merchant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umohpyro/better-auth-nuvion-example.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "vercel-build": "npm run migrate -- --yes && next build",
    "mock": "node mock-nuvion/server.mjs",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/e2e.mjs",
    "e2e:delete": "node scripts/e2e-delete.mjs",
    "e2e:interac": "node scripts/e2e-interac.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@umohpyro/better-auth-nuvion": "^0.11.4",
    "better-auth": "^1.7.25",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
